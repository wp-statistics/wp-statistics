{
  "name": "wp-statistics",
  "version": "1.0.0",
  "description": "The Most Popular Privacy-Friendly Analytics Plugin",
  "type": "module",
  "private": true,
  "sideEffects": [
    "*.css",
    "*.scss",
    "**/mini-chart.js",
    "**/tracker/entry.js",
    "**/exports.ts",
    "**/custom-components.ts",
    "**/registration.ts"
  ],
  "scripts": {
    "build": "npm run build:entries && npm run build:blocks && npm run build:react",
    "build:entries": "vite build --config vite.config.entries.js",
    "build:blocks": "vite build --config vite.config.blocks.js",
    "build:react": "vite build --config vite.config.react.ts",
    "start": "npm run dev",
    "dev": "npm run dev:react",
    "dev:entries": "vite build --config vite.config.entries.js --watch --mode development",
    "dev:react": "vite --config vite.config.react.ts",
    "watch": "npm run dev:entries",
    "watch:entries": "vite build --config vite.config.entries.js --watch",
    "watch:blocks": "vite build --config vite.config.blocks.js --watch",
    "watch:react": "vite build --config vite.config.react.ts --watch",
    "preview:react": "vite preview --config vite.config.react.ts",
    "lint:react": "eslint resources/react/src --config eslint.config.react.js",
    "lint:react:fix": "eslint resources/react/src --config eslint.config.react.js --fix",
    "lint:analytics": "pnpm --package=@ast-grep/cli dlx sg scan resources/react/src --config resources/react/.ast-grep/sgconfig.yml",
    "format:react": "prettier --write \"resources/react/**/*.{ts,tsx,js,jsx,json,css,scss,md}\" --config .prettierrc",
    "format:react:check": "prettier --check \"resources/react/**/*.{ts,tsx,js,jsx,json,css,scss,md}\" --config .prettierrc",
    "storybook": "storybook dev -p 6006",
    "build:storybook": "storybook build",
    "test:storybook": "vitest --project=storybook --run",
    "test:storybook:watch": "vitest --project=storybook",
    "test:storybook:ci": "vitest --project=storybook --run",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:report": "playwright show-report tests/e2e/reports",
    "test:e2e:start": "wp-env start",
    "test:e2e:stop": "wp-env stop",
    "test:e2e:clean": "wp-env clean all",
    "test:e2e:destroy": "wp-env destroy"
  },
  "dependencies": {
    "@babel/core": "^7.29.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-collapsible": "^1.1.12",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@tailwindcss/vite": "^4.2.2",
    "@tanstack/react-query": "^5.99.0",
    "@tanstack/react-router": "^1.168.18",
    "@tanstack/react-router-devtools": "^1.166.13",
    "@tanstack/react-table": "^8.21.3",
    "axios": "^1.15.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.8.0",
    "react": "^19.2.5",
    "react-day-picker": "^9.14.0",
    "react-dom": "^19.2.5",
    "react-simple-maps": "^3.0.0",
    "recharts": "2.15.4",
    "select2": "4.1.0-rc.0",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.2.2"
  },
  "devDependencies": {
    "@babel/preset-env": "^7.29.2",
    "@eslint/js": "^9.39.4",
    "@playwright/test": "^1.59.1",
    "@storybook/addon-a11y": "^10.3.5",
    "@storybook/addon-vitest": "^10.3.5",
    "@storybook/react": "^10.3.5",
    "@storybook/react-vite": "^10.3.5",
    "@tanstack/eslint-plugin-query": "^5.99.0",
    "@tanstack/eslint-plugin-router": "^1.161.6",
    "@tanstack/router-plugin": "^1.167.18",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^25.6.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/react-simple-maps": "^3.0.6",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/browser-playwright": "^4.1.4",
    "@vitest/coverage-v8": "^4.1.4",
    "@wordpress/env": "^11.3.0",
    "@wordpress/i18n": "^6.16.0",
    "autoprefixer": "^10.4.27",
    "eslint": "^9.39.4",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "eslint-plugin-simple-import-sort": "^13.0.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "glob": "^13.0.6",
    "globals": "^17.5.0",
    "jsdom": "^29.0.2",
    "lightningcss": "^1.32.0",
    "msw": "^2.13.2",
    "playwright": "^1.59.1",
    "postcss": "^8.5.9",
    "postcss-loader": "^8.2.1",
    "prettier": "^3.8.2",
    "readable-stream": "^4.7.0",
    "rtlcss": "^4.3.0",
    "sass": "^1.99.0",
    "sass-embedded": "^1.99.0",
    "sass-migrator": "^2.5.7",
    "shadcn": "^4.2.0",
    "storybook": "^10.3.5",
    "storybook-addon-rtl": "^3.0.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.58.1",
    "vite": "^8.0.8",
    "vitest": "^4.1.4"
  },
  "msw": {
    "workerDirectory": [
      ".storybook/public"
    ]
  }
}
